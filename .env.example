# Copie para .env (que fica fora do git) e preencha. Nunca coloque estes valores no código.

# Contato que vai no User-Agent das requisições às fontes (obrigatório para coletar).
CONTATO_VARREDURA=

# DOU pelo INLABS (cadastro gratuito em https://inlabs.in.gov.br).
INLABS_EMAIL=
INLABS_SENHA=

# Quem confere os campos críticos antes de publicar (ou use --por no publicar).
CONFERENTE=

# Só para postar no Telegram a partir do notebook (o GitHub Actions usa os GitHub Secrets).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CANAL=

# Não use: o modo api é pago. A extração é sempre pelo Claude Code (/varredura), sem custo.
ANTHROPIC_API_KEY=
